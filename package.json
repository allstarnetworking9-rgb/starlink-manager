{
  "name": "starlink-manager-pro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @starlink-manager-pro/api prisma migrate dev",
    "db:deploy": "pnpm --filter @starlink-manager-pro/api prisma migrate deploy",
    "db:generate": "pnpm --filter @starlink-manager-pro/api prisma generate",
    "db:seed": "pnpm --filter @starlink-manager-pro/api prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.0.12"
  }
}
