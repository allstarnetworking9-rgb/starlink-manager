{
  "name": "@starlink-manager-pro/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "echo \"Lint api belum diaktifkan\"",
    "test": "echo \"Test api belum diaktifkan\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "echo \"Format api belum diaktifkan\"",
    "clean": "rm -rf dist",
    "prisma": "dotenv -e ../../.env -- prisma",
    "prisma:format": "dotenv -e ../../.env -- prisma format",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e ../../.env -- node prisma/seed/index.js",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "@prisma/client": "^5.21.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.1",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.21.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- node prisma/seed/index.js"
  }
}
